# ── Network ────────────────────────────────────────────────────────────────
# LAN address of this server (used for WebRTC ICE candidates and public URLs).
LAN_IP=192.168.1.10
PUBLIC_WEBRTC_URL=http://192.168.1.10:8889
PUBLIC_HLS_URL=http://192.168.1.10:8888
# RTSP base as seen by the inference worker (native worker on the host: localhost).
WORKER_RTSP_URL=rtsp://localhost:8554
# Ollama as seen by the API container (native Ollama on macOS).
OLLAMA_URL=http://host.docker.internal:11434
# API URL baked into the console build (scripts/deploy.sh). Empty = http://<LAN_IP>:8081/api.
CONSOLE_API_URL=
# API image used by scripts/deploy.sh --pull. Defaults: ghcr.io/darmawanweb, main.
REGISTRY=
TAG=

# ── Secrets ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me
GCS_JWT_SECRET=change-me-to-a-long-random-string
GCS_ADMIN_USERNAME=admin
GCS_ADMIN_PASSWORD=change-me-on-first-login
# Optional shared secret for drone bridges (append ?token=... to the bridge URL).
GCS_BRIDGE_TOKEN=

# ── API ────────────────────────────────────────────────────────────────────
# Comma-separated (or a JSON array). Empty = built-in defaults.
GCS_CORS_ORIGINS=http://localhost:3000,http://192.168.1.10:8081,tauri://localhost,http://tauri.localhost
GCS_DJI_DEFAULT_DRONE_ID=m4t-001
GCS_AUTEL_ATTITUDE_UNIT=deg
# Visual Q&A: moondream (fast, English; answers translated if GCS_TRANSLATE_MODEL is set)
# or a multilingual VLM such as qwen2.5vl:3b / qwen3-vl:2b that answers in Indonesian directly.
GCS_VLM_MODEL=moondream
GCS_TRANSLATE_MODEL=llama3.2:3b
GCS_STT_ENGINE=faster-whisper
GCS_STT_MODEL=small

# ── Demo drone (simulated, for drop / mission demos) ───────────────────────
GCS_DEMO_ENABLED=true
GCS_DEMO_BASE_LAT=-6.2088
GCS_DEMO_BASE_LON=106.8456
